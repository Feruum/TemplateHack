# ChromaDB Configuration
AGENT_CHROMA_PERSIST_DIRECTORY=./data/chroma
AGENT_CHROMA_COLLECTION_NAME=agent_memory

# Agent Configuration
AGENT_AGENT_NAME=Agent
AGENT_AGENT_MAX_ITERATIONS=10

# alem.ai LLM Configuration (OpenAI-compatible)
# https://llm.alem.ai/v1
AGENT_LLM_BASE_URL=https://llm.alem.ai/v1
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=gemma4
AGENT_LLM_TEMPERATURE=0.6
AGENT_LLM_MAX_TOKENS=2048
AGENT_LLM_TIMEOUT_SECONDS=45
AGENT_LLM_MAX_RETRIES=2
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL=text-1024
AGENT_RERANK_API_KEY=
AGENT_RERANK_MODEL=reranker

# Azure AI Search is mandatory outside development. Local tests use the
# in-memory KnowledgeIndex substitute.
AGENT_KNOWLEDGE_BACKEND=azure_search
AGENT_AZURE_SEARCH_ENDPOINT=https://search-studyverse.search.windows.net
AGENT_AZURE_SEARCH_INDEX=deimos-knowledge-v1
AGENT_AZURE_SEARCH_SEMANTIC_CONFIGURATION=deimos-semantic
AGENT_EMBEDDING_DIMENSIONS=1024
AGENT_AZURE_CLIENT_ID=
AGENT_BLOB_ACCOUNT_URL=https://storage-account.blob.core.windows.net
AGENT_BLOB_DOCUMENT_CONTAINER=private-documents
AGENT_SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=service-bus.servicebus.windows.net
AGENT_INGESTION_QUEUE=document-ingestion
AGENT_INGESTION_MAX_FILE_BYTES=26214400
AGENT_INGESTION_MAX_DELIVERY_COUNT=10
AGENT_KRATOS_PUBLIC_URL=http://localhost:4433
AGENT_USE_RERANKER=true

# Durable dependencies (managed services in production)
AGENT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/agent
AGENT_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432/agent?sslmode=disable
AGENT_REDIS_URL=redis://redis:6379/0

# Admission control: never configure the global limit above 100.
AGENT_STREAM_GLOBAL_LIMIT=100
AGENT_STREAM_PER_USER_LIMIT=3
AGENT_STREAM_ADMISSION_WAIT_SECONDS=0.25
AGENT_STREAM_RETRY_AFTER_SECONDS=5
AGENT_STREAM_LEASE_TTL_SECONDS=180
AGENT_STREAM_LEASE_REFRESH_SECONDS=30

# OpenTelemetry Collector gateway
AGENT_OTLP_ENDPOINT=http://otel-collector:4317
AGENT_OTLP_INSECURE=true
AGENT_OTEL_TRACE_SAMPLE_RATIO=0.1

# Agent API authentication (optional)
# Single key
AGENT_AGENT_API_KEY=
# Comma-separated keys for rotation
AGENT_AGENT_API_KEYS=
