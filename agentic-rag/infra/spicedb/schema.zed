// SpiceDB Authorization Schema
// Implements Zanzibar-style ReBAC for the monorepo

definition user {}

definition organization {
    relation admin: user
    relation member: user

    permission can_manage = admin
    permission can_view = admin + member
}

definition document {
    relation owner: user
    relation editor: user
    relation viewer: user
    relation org: organization

    permission can_delete = owner
    permission can_edit = owner + editor + org->can_manage
    permission can_view = owner + editor + viewer + org->can_view
}

definition agent_session {
    relation owner: user

    permission can_access = owner
    permission can_delete = owner
}
