{
  "name": "agentic-rag-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.2.4",
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "dev": "turbo dev",
    "codegen": "turbo codegen",
    "typecheck": "turbo typecheck",
    "agent": "turbo dev --filter=agent",
    "auth": "turbo serve --filter=auth-service",
    "dashboard": "turbo dev --filter=admin-dashboard"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "turbo": "^2.5.4",
    "typescript": "^5.9.3"
  }
}