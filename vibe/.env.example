# Local web, API, and agent ports
PORT=3000
VITE_API_URL=http://localhost:3000
PUBLIC_WEBAPP_URL=http://localhost:5173
POSTGRES_PORT=54329
CHROMA_PORT=8000
AGENT_PORT=8001
AGENT_SERVICE_URL=http://127.0.0.1:8001

# Local PostgreSQL account database. Drizzle applies the migrations on `bun run dev`.
DATABASE_URL=postgresql://superuser:superpassword@localhost:54329/web_app_demo
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEBAPP_ORIGIN=http://localhost:5173

# Bun-to-agent secret. Keep this a local-only placeholder and change it before sharing a network.
AGENT_API_KEY=local-agent-dev-key-change-before-sharing

# OpenAI-compatible chat provider. Keep these blank until you choose a provider.
AGENT_LLM_BASE_URL=
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=

# OpenAI-compatible embedding endpoint. Blank values reuse the chat endpoint and API key.
AGENT_EMBEDDING_BASE_URL=
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_MODEL=

# Reranking is optional and disabled by default.
AGENT_USE_RERANKER=false
